---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ProductCard from '../../components/ProductCard.astro'; import { getProducts } from '../../lib/catalog'; import { categoryPageSchema } from '../../lib/structured-data';
export async function getStaticPaths(){const products=await getProducts();const categories=[{slug:'cat-food',name:'อาหารแมว',description:'เลือกดูอาหารแมวตามแบรนด์และสูตร พร้อมรายละเอียดสินค้าและช่องทางสอบถามผ่าน LINE'},{slug:'cat-litter',name:'ทรายแมว',description:'รวมทรายแมวหลายรูปแบบเพื่อเปรียบเทียบขนาด การจับตัว และข้อมูลผลิตภัณฑ์'}];return categories.map(category=>({params:{category:category.slug},props:{category,products}}));} const {category,products}=Astro.props; const matches=products.filter(product=>product.category===category.name); const structuredData=categoryPageSchema(category,matches);
---
<BaseLayout title={`${category.name} | MaoMao Cat Shop`} description={category.description} structuredData={structuredData}><div class="container-site py-10"><Breadcrumb items={[{label:'สินค้าทั้งหมด',href:'/products/'},{label:category.name}]} /><header class="max-w-3xl"><p class="text-sm font-bold uppercase tracking-widest text-primary">หมวดหมู่สินค้า</p><h1 class="heading-section mt-2">{category.name}</h1><p class="mt-4 text-muted">{category.description}</p></header><section class="mt-10"><h2 class="sr-only">รายการ{category.name}</h2><div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{matches.map(product=><ProductCard product={product}/>)}</div></section><section class="section-space border-t border-surface-highest pt-12"><h2 class="font-display text-2xl font-semibold">คำแนะนำก่อนเลือกซื้อ</h2><p class="mt-4 max-w-3xl text-muted">อ่านข้อมูลบนฉลากและรายละเอียดสินค้าให้ครบถ้วน ข้อมูลในเว็บไซต์เป็นแคตตาล็อกเบื้องต้น ควรยืนยันรุ่น ขนาด และราคาอีกครั้งกับร้านผ่าน LINE</p></section></div></BaseLayout>
