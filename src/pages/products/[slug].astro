---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ProductGallery from '../../components/ProductGallery.astro'; import ProductCard from '../../components/ProductCard.astro'; import Icon from '../../components/Icon.astro'; import { getProducts } from '../../lib/catalog'; import { site } from '../../config/site'; import { productPageSchema } from '../../lib/structured-data';
export async function getStaticPaths(){ const products=await getProducts();return products.map(product=>({params:{slug:product.slug},props:{product,products}})); }
const { product,products }=Astro.props; const {Content}=await product.entry.render(); const gallery=[{src:product.image,alt:product.alt},{src:'/images/cat-food-bowls.jpg',alt:`ภาพประกอบการเลือก ${product.name}`},{src:'/images/cat-lifestyle.jpg',alt:'แมวในบ้านที่อบอุ่น ภาพประกอบการดูแลแมว'}]; const structuredData=productPageSchema(product);
---
<BaseLayout title={`${product.name} ${product.brand} | MaoMao Cat Shop`} description={`${product.description} ดูรายละเอียด รหัสสินค้า และติดต่อ MaoMao Cat Shop ผ่าน LINE`} image={product.image} structuredData={structuredData}><div class="container-site py-10"><Breadcrumb items={[{label:'สินค้าทั้งหมด',href:'/products/'},{label:product.name}]} /><div class="grid gap-10 lg:grid-cols-2"><ProductGallery images={gallery} productName={product.name} /><section><p class="text-sm font-bold uppercase tracking-widest text-primary">{product.brand}</p><h1 class="heading-section mt-2">{product.name}</h1><p class="mt-3 text-lg text-muted">{product.description}</p><div class="mt-6 flex items-end gap-3">{product.oldPrice&&<span class="text-muted line-through">{product.oldPrice}</span>}<span class="text-3xl font-bold text-primary">{product.price}</span></div><div class="mt-8 rounded-xl border border-surface-highest bg-white p-5"><p class="text-sm text-muted">รหัสสินค้า</p><div class="mt-2 flex items-center justify-between gap-3"><code class="font-bold" data-code>{product.code}</code><button class="flex min-h-11 items-center gap-2 rounded-lg border border-outline-soft px-3 text-sm font-bold text-primary" type="button" data-copy><Icon name="copy" />คัดลอก</button></div><p class="mt-2 hidden text-sm text-success" data-copy-status role="status">คัดลอกรหัสสินค้าแล้ว</p></div><a class="line-shadow mt-8 flex min-h-14 w-full items-center justify-center gap-2 rounded-lg bg-line px-6 py-3 text-lg font-bold text-white" href={site.line.url} target="_blank" rel="noopener noreferrer"><Icon name="chat" />สอบถามสินค้านี้ทาง LINE</a><p class="mt-3 text-sm text-muted">แจ้งชื่อและรหัสสินค้าให้ร้านตรวจสอบรายละเอียด การจัดส่ง และวิธีชำระเงิน</p><div class="mt-10 border-t border-surface-highest pt-8"><h2 class="font-display text-2xl font-semibold">รายละเอียดสินค้า</h2><div class="prose-thai mt-4"><Content /></div></div></section></div><section class="section-space"><h2 class="heading-section">สินค้าอื่นที่คุณอาจสนใจ</h2><div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{products.filter(p=>p.slug!==product.slug).slice(0,4).map(p=><ProductCard product={p}/>)}</div></section></div><script>const copy=document.querySelector<HTMLButtonElement>('[data-copy]');copy?.addEventListener('click',async()=>{const code=document.querySelector('[data-code]')?.textContent??'';await navigator.clipboard.writeText(code);document.querySelector('[data-copy-status]')?.classList.remove('hidden');});</script></BaseLayout>
