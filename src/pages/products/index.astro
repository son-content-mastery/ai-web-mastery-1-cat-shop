---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ProductCard from '../../components/ProductCard.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import Icon from '../../components/Icon.astro'; import { getArticles, getProducts } from '../../lib/catalog';
const [products, articles] = await Promise.all([getProducts(), getArticles()]);
---
<BaseLayout title="สินค้าทั้งหมด | MaoMao Cat Shop" description="รวมอาหารแมว Royal Canin, Maxima และทรายแมว พร้อมรายละเอียดสินค้าและช่องทางปรึกษาผ่าน LINE">
<div class="container-site py-10"><Breadcrumb items={[{ label: 'สินค้าทั้งหมด' }]} /><div class="mb-10 max-w-3xl"><h1 class="heading-section">แหล่งรวมสินค้าเพื่อเจ้าเหมียวที่คุณรัก</h1><p class="mt-4 text-muted">คัดสรรสินค้าคุณภาพ ทั้ง <strong>อาหารแมว Royal Canin</strong>, <strong>Maxima</strong> และ <strong>ทรายแมว</strong> หลากหลายประเภท เพื่อให้คุณเปรียบเทียบและติดต่อร้านได้สะดวก</p></div>
<button class="mb-5 flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-outline-soft bg-white md:hidden" type="button" data-filter-toggle aria-controls="filters" aria-expanded="false"><Icon name="filter" />ตัวกรองสินค้า</button>
<div class="flex flex-col gap-6 md:flex-row"><aside class="hidden w-full shrink-0 md:block md:w-72" id="filters"><form class="space-y-7 rounded-xl border border-surface-highest bg-white p-6" data-filters><fieldset><legend class="mb-3 font-bold">หมวดหมู่สินค้า</legend><label class="flex min-h-10 items-center gap-3"><input class="size-5 accent-primary" type="checkbox" name="category" value="อาหารแมว" />อาหารแมว</label><label class="flex min-h-10 items-center gap-3"><input class="size-5 accent-primary" type="checkbox" name="category" value="ทรายแมว" />ทรายแมว</label></fieldset><fieldset><legend class="mb-3 font-bold">แบรนด์ยอดนิยม</legend>{['Royal Canin','Maxima','Tidy Cats'].map(brand => <label class="flex min-h-10 items-center gap-3"><input class="size-5 accent-primary" type="checkbox" name="brand" value={brand} />{brand}</label>)}</fieldset><button class="min-h-11 w-full rounded-lg border border-outline-soft text-sm font-bold text-primary" type="reset">ล้างตัวกรอง</button></form></aside>
<section class="flex-1"><div class="mb-6 flex flex-wrap items-center justify-between gap-3"><p class="text-sm text-muted" aria-live="polite">พบทั้งหมด <strong data-count>{products.length}</strong> รายการ</p><label class="text-sm text-muted">เรียงตาม: <select class="rounded-lg border border-outline-soft bg-transparent px-3 py-2 font-bold text-primary"><option>แนะนำสำหรับคุณ</option><option>ราคา: ต่ำไปสูง</option><option>ใหม่ล่าสุด</option></select></label></div><div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-product-grid>{products.map(product => <div data-product data-category={product.category} data-brand={product.brand}><ProductCard product={product} /></div>)}</div><p class="hidden rounded-xl border border-surface-highest bg-white p-8 text-center text-muted" data-empty>ไม่พบสินค้าที่ตรงกับตัวกรอง ลองยกเลิกบางตัวเลือก</p><nav class="mt-12 flex justify-center gap-2" aria-label="หน้ารายการสินค้า"><a class="grid size-10 place-items-center rounded-lg border border-outline-soft" href="/products/" aria-label="หน้าก่อนหน้า"><Icon name="chevron-left" /></a><a class="grid size-10 place-items-center rounded-lg bg-primary text-white" href="/products/" aria-current="page">1</a><span class="grid size-10 place-items-center rounded-lg border border-outline-soft text-muted">2</span><span class="grid size-10 place-items-center rounded-lg border border-outline-soft text-muted">3</span><span class="grid size-10 place-items-center rounded-lg border border-outline-soft text-muted"><Icon name="chevron-right" /></span></nav></section></div>
<section class="section-space border-t border-surface-highest py-12"><h2 class="font-display text-2xl font-semibold">ทำไมต้องเลือกสินค้ากับ MaoMao Cat Shop?</h2><div class="mt-6 grid gap-6 text-muted md:grid-cols-2"><p>เลือกดู <strong>ทรายแมว</strong> และอาหารแมวตามหมวดหมู่ แบรนด์ และช่วงวัยได้ในหน้าเดียว ก่อนเปิดรายละเอียดสินค้าเพื่อดูข้อมูลเพิ่มเติม</p><p>เว็บไซต์เป็นแคตตาล็อกสำหรับค้นหาและเปรียบเทียบสินค้า การสอบถามและสั่งซื้อดำเนินการกับร้านผ่าน LINE โดยตรง</p></div></section>
<section class="section-space"><h2 class="font-display text-2xl font-semibold">บทความน่ารู้สำหรับทาสแมว</h2><div class="mt-8 grid gap-6 md:grid-cols-3">{articles.map(article => <ArticleCard article={article} />)}</div></section></div>
<script>
const toggle=document.querySelector<HTMLButtonElement>('[data-filter-toggle]');const panel=document.querySelector<HTMLElement>('#filters');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));panel?.classList.toggle('hidden',open);});
const form=document.querySelector<HTMLFormElement>('[data-filters]');const cards=[...document.querySelectorAll<HTMLElement>('[data-product]')];const count=document.querySelector('[data-count]');const empty=document.querySelector('[data-empty]');function update(){const checked=[...form?.querySelectorAll<HTMLInputElement>('input:checked')??[]];const categories=checked.filter(i=>i.name==='category').map(i=>i.value);const brands=checked.filter(i=>i.name==='brand').map(i=>i.value);let shown=0;cards.forEach(card=>{const visible=(!categories.length||categories.includes(card.dataset.category??''))&&(!brands.length||brands.includes(card.dataset.brand??''));card.classList.toggle('hidden',!visible);if(visible)shown++;});if(count)count.textContent=String(shown);empty?.classList.toggle('hidden',shown>0);}form?.addEventListener('change',update);form?.addEventListener('reset',()=>setTimeout(update));
</script>
</BaseLayout>
