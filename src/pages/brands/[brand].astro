---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ProductCard from '../../components/ProductCard.astro'; import { getProducts } from '../../lib/catalog';
export async function getStaticPaths(){const products=await getProducts();const brands=[{slug:'royal-canin',name:'Royal Canin',keyword:'อาหารแมว royal canin',intro:'เลือกดูอาหารแมว Royal Canin จากแคตตาล็อก พร้อมรายละเอียดสูตร ขนาด และช่องทางสอบถามร้านผ่าน LINE'},{slug:'maxima',name:'Maxima',keyword:'อาหารแมว maxima',intro:'รวมข้อมูลอาหารแมว Maxima ในรูปแบบแคตตาล็อก เพื่อเปรียบเทียบรายละเอียดก่อนสอบถามร้าน'}];return brands.map(brand=>({params:{brand:brand.slug},props:{brand,products}}));} const {brand,products}=Astro.props; const matches=products.filter(product=>product.brand===brand.name);
---
<BaseLayout title={`${brand.keyword} | MaoMao Cat Shop`} description={brand.intro}><div class="container-site py-10"><Breadcrumb items={[{label:'สินค้าทั้งหมด',href:'/products/'},{label:brand.name}]} /><header class="max-w-3xl"><p class="text-sm font-bold uppercase tracking-widest text-primary">แบรนด์</p><h1 class="heading-section mt-2">อาหารแมว {brand.name}</h1><p class="mt-4 text-muted">{brand.intro}</p></header><section class="mt-10"><h2 class="sr-only">รายการสินค้า {brand.name}</h2>{matches.length?<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{matches.map(product=><ProductCard product={product}/>)}</div>:<div class="rounded-xl border border-surface-highest bg-white p-8 text-muted">ยังไม่มีรายการสินค้าเพิ่มเติมในข้อมูลสาธิต โปรดติดต่อร้านผ่าน LINE</div>}</section><section class="section-space border-t border-surface-highest pt-12"><h2 class="font-display text-2xl font-semibold">เลือกอาหารให้เหมาะกับแมว</h2><p class="mt-4 max-w-3xl text-muted">ตรวจสอบช่วงวัย น้ำหนัก ขนาดบรรจุ และคำแนะนำบนฉลากทุกครั้ง หากต้องเปลี่ยนอาหารควรค่อย ๆ ผสมอาหารใหม่ตามคำแนะนำของผู้ผลิต</p></section></div></BaseLayout>
