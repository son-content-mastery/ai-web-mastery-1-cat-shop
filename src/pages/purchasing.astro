---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumb from '../components/Breadcrumb.astro'; import Icon from '../components/Icon.astro'; import { site } from '../config/site';
---
<BaseLayout title="วิธีสั่งซื้อสินค้า | MaoMao Cat Shop" description="ขั้นตอนเลือกสินค้าและติดต่อ MaoMao Cat Shop ผ่าน LINE"><div class="container-site py-10"><Breadcrumb items={[{label:'วิธีสั่งซื้อ'}]} /><article class="mx-auto max-w-article"><h1 class="heading-section">วิธีสั่งซื้อสินค้า</h1><ol class="mt-8 space-y-5"><li class="rounded-xl border border-surface-highest bg-white p-6"><strong>1. เลือกสินค้า</strong><p class="mt-2 text-muted">ค้นหาจากหน้าสินค้าทั้งหมด หมวดหมู่ หรือแบรนด์ แล้วเปิดหน้ารายละเอียด</p></li><li class="rounded-xl border border-surface-highest bg-white p-6"><strong>2. คัดลอกรหัสสินค้า</strong><p class="mt-2 text-muted">ใช้ปุ่มคัดลอกรหัสบนหน้ารายละเอียดเพื่อลดความคลาดเคลื่อน</p></li><li class="rounded-xl border border-surface-highest bg-white p-6"><strong>3. ติดต่อร้านผ่าน LINE</strong><p class="mt-2 text-muted">ส่งชื่อและรหัสสินค้าเพื่อยืนยันราคา การจัดส่ง และวิธีชำระเงินกับร้านโดยตรง</p></li></ol><a class="line-shadow mt-8 flex min-h-14 items-center justify-center gap-2 rounded-lg bg-line px-6 py-3 font-bold text-white" href={site.line.url} target="_blank" rel="noopener noreferrer"><Icon name="chat" />เริ่มสอบถามผ่าน LINE</a></article></div></BaseLayout>
