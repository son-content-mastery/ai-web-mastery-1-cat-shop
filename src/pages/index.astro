---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import StitchHomeProductCard from '../components/StitchHomeProductCard.astro';
import { getProducts } from '../lib/catalog';
import { site } from '../config/site';

const products = await getProducts();
const categories = [
  { label: 'อาหารเม็ด', href: '/categories/cat-food/', image: '/images/home-category-dry-food.webp', width: 192, height: 105, alt: 'ถุงอาหารแมวชนิดเม็ดบนพื้นหลังสีขาว' },
  { label: 'อาหารเปียก', href: '/categories/cat-food/', image: '/images/home-category-wet-food.webp', width: 192, height: 105, alt: 'อาหารแมวชนิดเปียกในชามสีขาว' },
  { label: 'อาหารลูกแมว', href: '/products/royal-canin-kitten/', image: '/images/home-category-kitten.webp', width: 192, height: 108, alt: 'ลูกแมวกำลังกินอาหารจากชาม' },
  { label: 'ขนมแมว', href: '/products/?category=cat-treats', image: '/images/home-category-treats.webp', width: 192, height: 105, alt: 'ขนมแมวแบบแท่งกับอุ้งเท้าแมว' },
  { label: 'ทรายแมว', href: '/categories/cat-litter/', image: '/images/home-category-litter.webp', width: 192, height: 105, alt: 'ทรายแมวและที่ตักทรายในภาชนะไม้' },
  { label: 'ของเล่นและอุปกรณ์', href: '/products/?category=cat-accessories', image: '/images/home-category-accessories.webp', width: 192, height: 105, alt: 'อุปกรณ์แมวในห้องนั่งเล่นโทนสว่าง' },
];

const needs = ['ลูกแมว', 'แมวโต', 'แมวสูงวัย', 'แมวเลี้ยงในบ้าน', 'แมวเลือกกิน', 'ดูแลก้อนขน', 'ควบคุมน้ำหนัก'];
const featuredProducts = products.filter((product) => product.home);
const benefits = [
  { icon: 'info', title: 'ข้อมูลครบถ้วน', text: 'รายละเอียดสินค้าและข้อมูลเบื้องต้นที่อ่านและเปรียบเทียบได้ง่าย' },
  { icon: 'paw', title: 'เลือกตามช่วงวัย', text: 'แยกตัวเลือกตามช่วงวัยและความต้องการของน้องแมว' },
  { icon: 'chat', title: 'สอบถามผ่าน LINE', text: 'ติดต่อร้านเพื่อยืนยันรายละเอียดสินค้าก่อนตัดสินใจ' },
  { icon: 'truck', title: 'ตรวจสอบการจัดส่ง', text: 'สอบถามพื้นที่และเงื่อนไขการจัดส่งกับร้านได้โดยตรง' },
] as const;
---
<BaseLayout
  title="MaoMao Cat Shop - เลือกอาหารและสินค้าที่ใช่ให้น้องแมว"
  description="เลือกดูอาหารแมว ทรายแมว ขนมและอุปกรณ์สำหรับแมว พร้อมรายละเอียดสินค้าและช่องทางสอบถามร้านผ่าน LINE"
  image="/images/home-hero-cat.jpg"
  chrome="stitch-home"
  googleSiteVerification="B9NBE_XUghzw2Df2EcYJuqBTzZ7rCHdoMG36HF2jR88"
>
  <section class="overflow-hidden bg-white">
    <div class="container-site grid items-center gap-10 py-12 md:grid-cols-2 md:gap-12 md:py-20">
      <div class="order-2 md:order-1">
        <h1 class="heading-display text-ink">เลือกอาหารและสินค้าที่ใช่<br /><span class="text-primary">ให้น้องแมวในทุกช่วงวัยนะครับ</span></h1>
        <p class="mt-6 max-w-xl text-[17px] leading-[1.7] text-muted">เรารวบรวมอาหารแมว ทรายแมว และอุปกรณ์ที่จำเป็น พร้อมช่องทางสอบถามรายละเอียดผ่าน LINE เพื่อช่วยให้คุณเปรียบเทียบตัวเลือกได้สะดวกขึ้น</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="primary-action min-h-12 px-7 py-3" href="#shop">เลือกดูสินค้า</a>
          <a class="line-action min-h-12 px-7 py-3" href={site.line.url} target="_blank" rel="noopener noreferrer"><Icon name="chat" />ปรึกษาผ่าน LINE</a>
        </div>
      </div>
      <div class="order-1 relative md:order-2">
        <div class="aspect-square overflow-hidden rounded-3xl border-4 border-white bg-surface-low shadow-2xl">
          <img class="h-full w-full object-cover" src="/images/home-hero-cat.webp" alt="แมวขนยาวสีขาวนั่งบนโซฟาในห้องนั่งเล่นโทนอบอุ่น" width="512" height="318" loading="eager" decoding="sync" fetchpriority="high" />
        </div>
        <div class="absolute -bottom-5 -left-5 hidden rounded-2xl border border-surface-highest bg-white p-4 shadow-lg md:block">
          <div class="flex items-center gap-3"><span class="grid size-10 place-items-center rounded-full bg-[#dff9e8] text-success"><Icon name="check" /></span><div><p class="text-sm font-bold">คัดสรรอย่างใส่ใจ</p><p class="text-xs text-muted">อ่านรายละเอียดก่อนเลือกซื้อ</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-deferred-section home-category-section py-20" id="shop" aria-labelledby="category-heading">
    <div class="container-site">
      <h2 class="heading-section text-center" id="category-heading">เลือกช้อปตามหมวดหมู่</h2>
      <div class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6">
        {categories.map((category) => (
          <a class="group flex flex-col items-center gap-4 text-center font-bold" href={category.href}>
            <span class="flex aspect-square w-full items-center justify-center overflow-hidden rounded-full border border-surface-highest bg-white p-4 transition-colors group-hover:border-primary"><img class="size-24 object-contain transition-transform duration-300 group-hover:scale-105" src={category.image} alt={category.alt} width={category.width} height={category.height} loading="lazy" decoding="async" /></span>
            <span class="group-hover:text-primary">{category.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-deferred-section home-need-section bg-surface-low py-20" aria-labelledby="need-heading">
    <div class="container-site">
      <h2 class="heading-section" id="need-heading">เลือกตามความต้องการ</h2>
      <p class="mt-2 text-muted">เพราะน้องแมวแต่ละตัวมีความต้องการที่แตกต่างกัน</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {needs.map((need, index) => <a class:list={['min-h-11 rounded-full border px-5 py-2 text-sm transition-colors', index === 0 ? 'border-primary bg-primary font-bold text-white' : 'border-outline bg-white text-ink hover:border-primary hover:text-primary']} href={`/products/?need=${encodeURIComponent(need)}`}>{need}</a>)}
      </div>
    </div>
  </section>

  <section class="home-deferred-section home-featured-section py-20" aria-labelledby="featured-heading">
    <div class="container-site">
      <div class="flex items-end justify-between gap-6">
        <div><h2 class="heading-section" id="featured-heading">สินค้าแนะนำ</h2><p class="mt-2 text-muted">ตัวอย่างอาหารแมวและสินค้าที่เลือกดูรายละเอียดได้</p></div>
        <a class="hidden font-bold text-primary hover:underline md:block" href="/products/">ดูทั้งหมด</a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredProducts.map((product) => <StitchHomeProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="home-deferred-section home-benefit-section bg-surface-container py-20" aria-labelledby="benefit-heading">
    <div class="container-site text-center">
      <h2 class="heading-section" id="benefit-heading">ทำไมต้องเลือก MaoMao Cat Shop</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((benefit) => <article class="card-lift rounded-2xl border border-outline-soft bg-white p-8"><Icon name={benefit.icon} class="mx-auto size-11 text-primary" /><h3 class="mt-4 font-display text-xl font-semibold">{benefit.title}</h3><p class="mt-2 text-sm text-muted">{benefit.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="home-deferred-section home-brand-section border-y border-surface-highest py-14" aria-label="แบรนด์ที่มีในแคตตาล็อก">
    <div class="container-site"><p class="text-center text-sm font-bold text-muted">แบรนด์ที่มีในแคตตาล็อก</p><div class="mt-7 flex items-center justify-center gap-12 opacity-70 grayscale"><img class="h-12 w-auto object-contain" src="/images/home-logo-royal-canin.webp" alt="Royal Canin" width="160" height="48" loading="lazy" decoding="async" /><img class="h-12 w-auto object-contain" src="/images/home-logo-maxima.webp" alt="Maxima" width="160" height="48" loading="lazy" decoding="async" /></div></div>
  </section>

  <section class="home-deferred-section home-article-section py-20" aria-labelledby="article-heading">
    <div class="container-site">
      <h2 class="heading-section" id="article-heading">บทความน่าสนใจ</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <a class="group overflow-hidden rounded-2xl border border-surface-highest bg-white transition-colors hover:border-primary" href="/blog/best-dry-cat-food/"><div class="grid h-full md:grid-cols-2"><div class="aspect-[4/3] overflow-hidden md:aspect-auto"><img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src="/images/home-article-food.webp" alt="แมวสีส้มยืนข้างชามอาหารเม็ด" width="512" height="384" loading="lazy" decoding="async" /></div><div class="flex flex-col justify-center p-7"><span class="text-xs font-bold uppercase text-primary">CAT NUTRITION</span><h3 class="mt-3 font-display text-2xl font-semibold leading-snug group-hover:text-primary">อาหารเม็ดแมว ยี่ห้อไหนดี? เลือกอย่างไรให้เหมาะกับน้องแมว</h3><p class="mt-3 text-sm text-muted">คู่มือพิจารณาฉลากและเลือกสูตรอาหารให้สอดคล้องกับช่วงวัยของแมว</p></div></div></a>
        <div class="grid gap-6">
          <a class="group flex gap-5" href="/blog/choose-cat-litter/"><span class="size-28 shrink-0 overflow-hidden rounded-xl border border-surface-highest"><img class="h-full w-full object-cover" src="/images/home-article-litter.webp" alt="อุปกรณ์สำหรับดูแลกระบะทรายแมว" width="128" height="128" loading="lazy" decoding="async" /></span><span class="flex flex-col justify-center"><strong class="group-hover:text-primary">ทรายแมวแต่ละประเภทต่างกันอย่างไร?</strong><span class="mt-2 text-sm text-muted">ทำความรู้จักชนิดทราย การจับตัว ฝุ่น และการควบคุมกลิ่นก่อนเลือกใช้</span></span></a>
          <a class="group flex gap-5 border-t border-surface-highest pt-6" href="/blog/maxima-cat-food-guide/"><span class="size-28 shrink-0 overflow-hidden rounded-xl border border-surface-highest"><img class="h-full w-full object-cover" src="/images/home-article-health.webp" alt="แมวกำลังเล่นในห้องที่มีแสงธรรมชาติ" width="128" height="128" loading="lazy" decoding="async" /></span><span class="flex flex-col justify-center"><strong class="group-hover:text-primary">แนวทางดูแลแมวให้เหมาะกับกิจวัตรในบ้าน</strong><span class="mt-2 text-sm text-muted">อ่านข้อมูลสินค้าและปรับการเลือกอาหารอย่างค่อยเป็นค่อยไป</span></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-deferred-section home-line-section px-4 pb-20" aria-labelledby="line-heading">
    <div class="mx-auto max-w-site overflow-hidden rounded-3xl border border-line/20 bg-[#f0faf4]">
      <div class="grid items-stretch md:grid-cols-2"><div class="p-8 md:p-16"><h2 class="heading-section text-success" id="line-heading">ยังไม่แน่ใจว่าควรเลือกสินค้าแบบไหนให้น้องแมว?</h2><p class="mt-4 text-success">ส่งชื่อสินค้าหรือความต้องการให้ร้านช่วยตรวจสอบรายละเอียดเพิ่มเติมผ่าน LINE</p><a class="line-action mt-8 min-h-12 px-7 py-3" href={site.line.url} target="_blank" rel="noopener noreferrer"><Icon name="chat" />แอด LINE ปรึกษาเรา</a></div><div class="relative hidden min-h-80 md:block"><img class="absolute inset-0 h-full w-full object-cover" src="/images/home-line-consultant.webp" alt="พนักงานร้านกำลังใช้โทรศัพท์ในร้านผลิตภัณฑ์สัตว์เลี้ยง" width="512" height="384" loading="lazy" decoding="async" /><span class="absolute inset-0 bg-gradient-to-r from-[#f0faf4] to-transparent" aria-hidden="true"></span></div></div>
    </div>
  </section>
</BaseLayout>
