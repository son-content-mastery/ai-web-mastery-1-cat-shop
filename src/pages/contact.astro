---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumb from '../components/Breadcrumb.astro'; import Icon from '../components/Icon.astro'; import { site } from '../config/site';
---
<BaseLayout title="ติดต่อ MaoMao Cat Shop" description="ติดต่อ MaoMao Cat Shop เพื่อสอบถามสินค้าและวิธีสั่งซื้อผ่าน LINE Official Account"><div class="container-site py-10"><Breadcrumb items={[{label:'ติดต่อเรา'}]} /><section class="mx-auto max-w-article rounded-xl border border-surface-highest bg-white p-8 text-center"><h1 class="heading-section">ติดต่อเรา</h1><p class="mt-4 text-muted">สอบถามชื่อสินค้า รหัสสินค้า ราคา และรายละเอียดการจัดส่งกับร้านผ่าน LINE</p><a class="line-shadow mt-8 inline-flex min-h-14 items-center gap-2 rounded-lg bg-line px-7 py-3 text-lg font-bold text-white" href={site.line.url} target="_blank" rel="noopener noreferrer"><Icon name="chat" />LINE {site.line.id}</a><p class="mt-5 text-sm text-muted">LINE Official Account ของ MaoMao Cat Shop</p></section></div></BaseLayout>
