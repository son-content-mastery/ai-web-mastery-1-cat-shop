---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StitchHomeHeader from '../components/StitchHomeHeader.astro';
import StitchHomeFooter from '../components/StitchHomeFooter.astro';
import '../styles/global.css';
import { site } from '../config/site';
interface Props { title: string; description: string; image?: string; noindex?: boolean; chrome?: 'default' | 'stitch-home'; structuredData?: Record<string, unknown>; googleSiteVerification?: string; }
const { title, description, image = '/images/cat-lifestyle.jpg', noindex = false, chrome = 'default', structuredData, googleSiteVerification } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.canonicalBase);
const imageUrl = new URL(image, site.canonicalBase);
const serializedStructuredData = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---
<!doctype html><html lang="th"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}<link rel="canonical" href={canonical} /><meta property="og:type" content="website" /><meta property="og:locale" content="th_TH" /><meta property="og:site_name" content={site.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={imageUrl} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />{serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}<title>{title}</title></head><body><a class="sr-only z-[100] bg-white p-3 focus:not-sr-only focus:fixed focus:left-3 focus:top-3" href="#main">ข้ามไปยังเนื้อหาหลัก</a>{chrome === 'stitch-home' ? <StitchHomeHeader /> : <Header />}<main id="main"><slot /></main>{chrome === 'stitch-home' ? <StitchHomeFooter /> : <Footer />}</body></html>
