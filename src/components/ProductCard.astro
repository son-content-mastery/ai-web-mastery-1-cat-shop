---
import type { Product } from '../lib/catalog';
const { product } = Astro.props as { product: Product };
---
<article class="card-lift overflow-hidden rounded-xl border border-surface-highest bg-white">
  <a class="group block aspect-square overflow-hidden bg-surface-low" href={`/products/${product.slug}/`} aria-label={`ดูรายละเอียด ${product.name}`}>
    <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" src={product.image} alt={product.alt} width="512" height="279" loading="lazy" decoding="async" />
  </a>
  <div class="p-5"><p class="text-[.65rem] font-bold uppercase tracking-[.15em] text-primary">{product.brand}</p><h2 class="mt-1 font-display text-xl font-medium"><a href={`/products/${product.slug}/`}>{product.name}</a></h2><p class="mt-1 min-h-12 text-sm text-muted">{product.description}</p><div class="mt-4 flex items-end justify-between gap-3"><div>{product.oldPrice && <p class="text-xs text-muted line-through">{product.oldPrice}</p>}<p class="text-xl font-bold text-primary">{product.price}</p></div><a class="rounded-lg border border-outline-soft bg-surface-low px-4 py-2 text-sm font-bold text-primary hover:bg-primary hover:text-white" href={`/products/${product.slug}/`}>ดูรายละเอียด</a></div></div>
</article>
